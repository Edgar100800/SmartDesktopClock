#pragma once

// Copy this file to LocalSecrets.h. Replace every example value locally.
// Never commit LocalSecrets.h or paste real passwords into documentation.

// Recovery access point. WPA2 requires 8 to 63 printable ASCII characters.
#define PIXELIT_AP_SSID "PIXELIT"
#define PIXELIT_AP_PASSWORD "replace-with-a-private-password"

// Preferred 2.4 GHz network used automatically at startup.
// ESP8266 does not support 5 GHz or WPA3-only networks.
#define PIXELIT_WIFI_SSID "replace-with-your-2.4ghz-ssid"
#define PIXELIT_WIFI_PASSWORD "replace-with-your-wifi-password"
